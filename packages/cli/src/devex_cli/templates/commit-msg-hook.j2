#!/usr/bin/env bash
# commit-msg hook — generated by devex init ({{ generated_date }})
# Enforces the Work ID commit message convention: [WORK-ID] Description
#
# Pattern: {{ commit_pattern }}

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN='{{ commit_pattern }}'

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✗ devex: Commit message rejected."
  echo ""
  echo "    Message : $COMMIT_MSG"
  echo "    Pattern : $PATTERN"
  echo ""
  echo "    Expected format: [WORK-ID] Short description"
  echo "    Example:         [FIN-123] Add transaction validation"
  echo ""
  exit 1
fi
