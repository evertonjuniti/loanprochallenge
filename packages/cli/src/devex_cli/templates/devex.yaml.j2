# yaml-language-server: $schema=https://raw.githubusercontent.com/{{ org }}/{{ repo }}/main/packages/workflow-framework/devex.schema.json
# devex.yaml — {{ service_name }} service configuration
#
# Generated by `devex init` on {{ generated_date }}.
# Validate locally at any time with: devex check
#
# Language: {{ language_display }}
# The `runtime.appLanguage` value below determines which language adapter the
# workflow-framework activates in CI (test setup, unit tests, linting, etc.).

schemaVersion: 1

service:
  name: {{ service_name }}
  owner: {{ owner }}
  type: {{ service_type }}

workTracking:
  workIdPattern: "^[A-Z]+-[0-9]+$"
  branchPattern: "^(feature|fix|chore|hotfix)/[A-Z]+-[0-9]+-[a-z0-9-]+$"
  commitPattern: "^\\[[A-Z]+-[0-9]+\\] .+"
  prTitlePattern: "^\\[[A-Z]+-[0-9]+\\] .+"
{% if since_commit %}  sinceCommit: "{{ since_commit }}"  # Commits before this SHA (pre-init history) are excluded from validation.
{% endif %}

# ---------------------------------------------------------------------------
# runtime — consumed by workflow-framework to select the language adapter.
# Changing appLanguage here switches the CI setup, test, and lint commands
# automatically. No changes to the workflow file are needed.
# ---------------------------------------------------------------------------
runtime:
  appLanguage: {{ app_language }}
  infraLanguage: {{ infra_language }}
  infraFramework: {{ infra_framework }}

# ---------------------------------------------------------------------------
# local — commands for developer machines (devex validate, pre-push hook).
# ---------------------------------------------------------------------------
local:
  testCommand: "{{ local_test }}"
  lintCommand: "{{ local_lint }}"
  contractTestCommand: "{{ local_contract }}"
  propertyTestCommand: "{{ local_property }}"

# ---------------------------------------------------------------------------
# ci — commands for CI (workflow-framework language adapter).
# These must match what the adapter expects, or the adapter falls back to its
# own defaults if omitted.
# ---------------------------------------------------------------------------
ci:
  smallTests:
    unit: "{{ ci_unit }}"
    property: "{{ ci_property }}"
    contract: "{{ ci_contract }}"
    lint: "{{ ci_lint }}"
  cdk:
    workingDirectory: "{{ cdk_dir }}"
    synthCommand: "pnpm cdk synth"
    diffCommand: "pnpm cdk diff"
    deployCommand: "pnpm cdk deploy --require-approval never"

# ---------------------------------------------------------------------------
# environments — maps logical names to CDK stacks and GitHub Environments.
# ---------------------------------------------------------------------------
environments:
  sandbox:
    awsRegion: us-east-1
    cdkStack: {{ service_pascal }}Sandbox
    githubEnvironment: sandbox
  staging:
    awsRegion: us-east-1
    cdkStack: {{ service_pascal }}Staging
    githubEnvironment: staging
  production:
    awsRegion: us-east-1
    cdkStack: {{ service_pascal }}Production
    githubEnvironment: production

telemetry:
  sink: github-artifact
  auditFormat: ndjson

# ---------------------------------------------------------------------------
# workflowVersion — governs which version of the reusable workflow is called.
# Must be a semver tag (e.g. v0.1.0) or a full 40-char SHA. "main" is
# rejected by the governance job.
# ---------------------------------------------------------------------------
workflowVersion:
  ref: "{{ workflow_ref }}"
