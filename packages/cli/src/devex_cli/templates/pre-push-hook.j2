#!/usr/bin/env bash
# pre-push hook — generated by devex init ({{ generated_date }})
# Runs devex check and local test/lint commands before pushing.

set -e

# Resolve uv — git hooks run with a minimal PATH so the uv binary may not be
# found even when it works in an interactive terminal. Create a shell function
# that delegates to "python -m uv" so that any "uv run …" commands below work
# transparently without needing to rewrite the individual command strings.
if ! command -v uv &>/dev/null && python -m uv --version &>/dev/null 2>&1; then
  uv() { python -m uv "$@"; }
  export -f uv
fi

# Resolve devex — git hooks run with a minimal PATH so the devex entry-point
# script may not be found even when it works in an interactive terminal.
# Fall back to "python -m devex_cli" which works as long as the package is
# installed in the active Python environment.
if ! command -v devex &>/dev/null; then
  devex() { python -m devex_cli "$@"; }
  export -f devex
fi

echo ""
echo "  devex: Running pre-push checks for {{ service_name }}…"
echo ""

# 1. Golden Path compliance
devex check

# 2. Lint
echo "  Running lint: {{ local_lint }}"
{{ local_lint }}

# 3. Unit tests
echo "  Running tests: {{ local_test }}"
{{ local_test }}

echo ""
echo "  ✓ devex: All pre-push checks passed."
echo ""
